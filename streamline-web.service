[Unit]
Description=Streamline Web UI
After=network.target

[Service]
Type=simple
User=abhishek
WorkingDirectory=/home/abhishek/streamline
EnvironmentFile=/home/abhishek/streamline/.env
ExecStart=/home/abhishek/streamline/venv/bin/python3 -m recommender.web
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamline-web

[Install]
WantedBy=multi-user.target
