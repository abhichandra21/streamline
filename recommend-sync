#!/bin/bash
# Move user state (watchlist, ratings, archive, show tracking, search history)
# between this install and the home server. See tools/sync_user_state.py.
#
#   ./recommend-sync status
#   ./recommend-sync pull
#   ./recommend-sync push [--force]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$SCRIPT_DIR/.venv"

if [ ! -d "$VENV" ]; then
    echo "Error: venv not found at $VENV. Run: python3 -m venv .venv && pip install -r requirements.txt" >&2
    exit 1
fi
source "$VENV/bin/activate"

cd "$SCRIPT_DIR"
exec python3 -m tools.sync_user_state "$@"
