#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# .env is optional: keys may already be in the environment (Docker, systemd).
if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a; source "$SCRIPT_DIR/.env"; set +a
fi
# Use the project virtualenv when there is one; Docker installs into the system Python.
for venv in .venv venv; do
    if [ -f "$SCRIPT_DIR/$venv/bin/activate" ]; then
        source "$SCRIPT_DIR/$venv/bin/activate"
        break
    fi
done

case "${1:-}" in
    setup)
        shift
        exec python3 -m recommender.setup "$@"
        ;;
    plex)
        shift
        exec python3 -m recommender.plex "$@"
        ;;
    *)
        exec python3 -m recommender.main "$@"
        ;;
esac
